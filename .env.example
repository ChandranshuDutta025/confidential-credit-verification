# Midnight Network Configuration

# Network target: undeployed (local devnet), preview, or preprod
VITE_NETWORK=preview

# Deployed contract address (set after running npm run deploy)
VITE_CONTRACT_ADDRESS=

# Proof server URL (local: http://127.0.0.1:6300)
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Indexer GraphQL endpoint
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql

# Midnight node WebSocket URL
VITE_NODE_URL=https://rpc.preview.midnight.network

# For preprod network:
# VITE_NETWORK=preprod
# VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# VITE_NODE_URL=https://rpc.preprod.midnight.network
