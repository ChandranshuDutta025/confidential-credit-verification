# Midnight Network Configuration

# Network target: preprod (recommended), undeployed (local devnet), or preview
NEXT_PUBLIC_NETWORK=preprod

# Deployed contract address (set after running npm run deploy)
NEXT_PUBLIC_CONTRACT_ADDRESS=60b892512f11275c9f5260a0983197d90fb2c476d425795c0371ee9d36e9870d

# Proof server URL (local: http://127.0.0.1:6300)
NEXT_PUBLIC_PROOF_SERVER_URL=http://127.0.0.1:6300

# Indexer GraphQL endpoint
NEXT_PUBLIC_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql

# Midnight node WebSocket URL
NEXT_PUBLIC_NODE_URL=https://rpc.preprod.midnight.network
